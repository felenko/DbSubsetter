
<Window x:Class="DbSubsetter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBSubsetter"
        Height="780"
        Width="1000">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2A4A" Offset="0"/>
            <GradientStop Color="#1E1E2E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Wizard Navigation -->
        <Border Background="#232336"
                BorderBrush="#3F3F55"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="12">

                <TextBlock Text="DBSubsetter"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E4E4F0"
                           Margin="8"/>

                <TextBlock Text="Database subset tool"
                           Foreground="#9CA3AF"
                           Margin="8,0,8,20"/>

                <Button Style="{StaticResource WizardStepButton}"
                        Tag="1"
                        Content="Connection"/>

                <Button Style="{StaticResource WizardStepButton}"
                        Tag="2"
                        Content="Root Data"/>

                <Button Style="{StaticResource WizardStepButton}"
                        Tag="3"
                        Content="Tables"/>

                <Button Style="{StaticResource WizardStepButton}"
                        Tag="4"
                        Content="Destination"/>

                <Button Style="{StaticResource WizardStepButton}"
                        Tag="5"
                        Content="Run"/>

            </StackPanel>

        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Connection"
                       FontSize="18"
                       Foreground="#06B6D4"
                       Margin="0,0,0,16"/>

            <Border Grid.Row="1"
                    Background="#2A2A3C"
                    BorderBrush="#3F3F55"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Server"
                               Foreground="#E4E4F0"/>
                    <TextBox Margin="0,4,0,12"/>

                    <TextBlock Text="Database"
                               Foreground="#E4E4F0"/>
                    <TextBox Margin="0,4,0,12"/>

                    <Button Content="Test Connection"
                            Background="#4F46E5"
                            Foreground="White"
                            Width="160"
                            Height="32"/>

                </StackPanel>

            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Back"
                        Margin="0,0,8,0"
                        Padding="14,6"/>

                <Button Content="Next"
                        Background="#4F46E5"
                        Foreground="White"
                        Padding="16,8"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
