<Window x:Class="DbSubsetter.UI.BrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DbSubsetter.UI"
        Title="Database Browser" Height="700" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/DbSubsetter.UI;component/Icons/BrowseIcon.png">
    <Window.Resources>
        <local:BoolToCheckMarkConverter x:Key="BoolToCheckConverter" />
        <!-- The browser uses system-default (light) backgrounds, so override to dark text -->
        <Style TargetType="Label">
            <Setter Property="Foreground"        Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"        Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Toolbar -->
            <RowDefinition Height="*" />     <!-- Main 3-pane + query panel -->
            <RowDefinition Height="Auto" />  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <ToolBarTray Grid.Row="0" IsLocked="True">
            <ToolBar>
                <Label Content="Row limit:" />
                <TextBox Width="60"
                         Text="{Binding RowLimit, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}" Padding="8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="Gray" />
            </ToolBar>
        </ToolBarTray>

        <!-- Row 1: Main area (3-pane browser + query panel) -->
        <Grid Grid.Row="1" Margin="0,4,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="150" />  <!-- 3-pane browser -->
                <RowDefinition Height="5" />                    <!-- horizontal splitter -->
                <RowDefinition Height="*" MinHeight="120" />   <!-- SQL query panel -->
            </Grid.RowDefinitions>

            <!-- ── 3-pane browser ─────────────────────────────────────────── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="140" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="280" MinWidth="160" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Table list with search -->
                <DockPanel Grid.Column="0">
                    <Label DockPanel.Dock="Top" Content="Tables" FontWeight="Bold" Padding="2,2,2,2" />

                    <!-- Search box -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding TableFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type to filter tables"
                                 Padding="4,3" />
                        <Button Grid.Column="1" Command="{Binding ClearTableFilterCommand}"
                                Padding="4,3" Margin="2,0,0,0" ToolTip="Clear filter"
                                Content="✕" FontSize="10" />
                    </Grid>

                    <!-- Table list with checkboxes -->
                    <ListView ItemsSource="{Binding TablesView}"
                              SelectedItem="{Binding SelectedTableItem}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              BorderThickness="1" BorderBrush="LightGray">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" />

                <!-- Col 2: Columns grid -->
                <DockPanel Grid.Column="2">
                    <Label DockPanel.Dock="Top" Content="Columns" FontWeight="Bold" Padding="2,2,2,2" />
                    <DataGrid ItemsSource="{Binding Columns}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              BorderThickness="1" BorderBrush="LightGray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="110" />
                            <DataGridTemplateColumn Header="PK" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsPrimaryKey, Converter={StaticResource BoolToCheckConverter}}"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FK →" Width="140">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}.{1}">
                                        <Binding Path="FkReferencedTable" TargetNullValue="" />
                                        <Binding Path="FkReferencedColumn" TargetNullValue="" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" />

                <!-- Col 4: Rows grid with filter bar -->
                <DockPanel Grid.Column="4">
                    <Label DockPanel.Dock="Top" Content="Rows" FontWeight="Bold" Padding="2,2,2,2" />

                    <!-- WHERE filter bar (also sets the subsetting rule) -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Search:" VerticalAlignment="Center" Padding="0,0,4,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Instantly filter loaded rows across all columns" />
                        <Label Grid.Column="2" Content="WHERE:" VerticalAlignment="Center" Padding="8,0,4,0" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding WhereClause, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="SQL WHERE clause — also saved as the subsetting row filter for this table (e.g. Status='Active')">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyWhereCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="4" Command="{Binding ApplyWhereCommand}"
                                Padding="8,3" Margin="4,0,0,0"
                                ToolTip="Re-fetch rows using the WHERE clause">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                                <TextBlock Text="Apply" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid ItemsSource="{Binding RowsView}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              BorderThickness="1" BorderBrush="LightGray" />
                </DockPanel>
            </Grid>

            <!-- Horizontal splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="LightGray" />

            <!-- ── SQL Query panel ────────────────────────────────────────── -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- label + toolbar -->
                    <RowDefinition Height="80" MinHeight="40" />  <!-- SQL input -->
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="40" />   <!-- results -->
                    <RowDefinition Height="Auto" />   <!-- status -->
                </Grid.RowDefinitions>

                <!-- Query label + Execute button -->
                <DockPanel Grid.Row="0" Margin="0,4,0,2">
                    <Label DockPanel.Dock="Left" Content="SQL Query" FontWeight="Bold" Padding="2,2,6,2" />
                    <Button DockPanel.Dock="Right" Command="{Binding ExecuteQueryCommand}"
                            Padding="10,3" Margin="4,0,0,0"
                            Background="#FF2196F3" Foreground="White" FontWeight="Bold"
                            ToolTip="Execute query (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="White" VerticalAlignment="Center"
                                       Margin="0,0,5,0" Text="&#xE768;" />
                            <TextBlock Text="Execute" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="Gray"
                               Margin="0,0,8,0" FontSize="11"
                               Text="{Binding QueryStatus}" />
                </DockPanel>

                <!-- SQL TextBox -->
                <TextBox Grid.Row="1"
                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="LightGray"
                         Padding="4"
                         ToolTip="Type any SQL query and click Execute">
                    <TextBox.InputBindings>
                        <KeyBinding Key="F5" Command="{Binding ExecuteQueryCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" />

                <!-- Query results -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding QueryResultsView}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          BorderThickness="1" BorderBrush="LightGray" />
            </Grid>
        </Grid>

        <!-- Row 2: Footer -->
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Left"
                    Command="{Binding UseAsRootCommand}"
                    Padding="12,5"
                    FontWeight="Bold"
                    Background="#FF2196F3"
                    Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,6,0" Text="&#xE735;" />
                    <TextBlock Text="Use as Root" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray">
                <Run Text="Select a row in the browser then click " />
                <Run Text="Use as Root" FontWeight="Bold" />
                <Run Text=" to set it as the subset entry point. The WHERE clause is also saved as a subsetting row filter." />
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
