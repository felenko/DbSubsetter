<Window x:Class="DbSubsetter.UI.BrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DbSubsetter.UI"
        Title="Database Browser" Height="600" Width="1100"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/DbSubsetter.UI;component/Icons/BrowseIcon.png">
    <Window.Resources>
        <local:BoolToCheckMarkConverter x:Key="BoolToCheckConverter" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <ToolBarTray Grid.Row="0" IsLocked="True">
            <ToolBar>
                <Label Content="Row limit:" />
                <TextBox Width="60"
                         Text="{Binding RowLimit, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}" Padding="8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="Gray" />
            </ToolBar>
        </ToolBarTray>

        <!-- Row 1: 3-pane splitter -->
        <Grid Grid.Row="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="260" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Col 0: Table list -->
            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top" Content="Tables" FontWeight="Bold" Padding="2,2,2,2" />
                <ListView ItemsSource="{Binding Tables}"
                          SelectedItem="{Binding SelectedTable}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BorderThickness="1" BorderBrush="LightGray" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="Transparent" />

            <!-- Col 2: Columns grid -->
            <DockPanel Grid.Column="2">
                <Label DockPanel.Dock="Top" Content="Columns" FontWeight="Bold" Padding="2,2,2,2" />
                <DataGrid ItemsSource="{Binding Columns}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          BorderThickness="1" BorderBrush="LightGray">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="120" />
                        <DataGridTemplateColumn Header="PK" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsPrimaryKey, Converter={StaticResource BoolToCheckConverter}}"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="FK →" Width="150">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}.{1}">
                                    <Binding Path="FkReferencedTable" TargetNullValue="" />
                                    <Binding Path="FkReferencedColumn" TargetNullValue="" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="Transparent" />

            <!-- Col 4: Rows grid with filter bar -->
            <DockPanel Grid.Column="4">
                <Label DockPanel.Dock="Top" Content="Rows" FontWeight="Bold" Padding="2,2,2,2" />

                <!-- Filter bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Search:" VerticalAlignment="Center" Padding="0,0,4,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Instantly filter loaded rows across all columns" />
                    <Label Grid.Column="2" Content="WHERE:" VerticalAlignment="Center" Padding="8,0,4,0" />
                    <TextBox Grid.Column="3"
                             Text="{Binding WhereClause, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="SQL WHERE clause — re-fetches from DB (e.g. Name LIKE '%Smith%')">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ApplyWhereCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="4" Command="{Binding ApplyWhereCommand}"
                            Padding="8,3" Margin="4,0,0,0"
                            ToolTip="Re-fetch rows using the WHERE clause">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                            <TextBlock Text="Apply" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <DataGrid ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          BorderThickness="1" BorderBrush="LightGray" />
            </DockPanel>
        </Grid>

        <!-- Row 2: Footer -->
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Left"
                    Command="{Binding UseAsRootCommand}"
                    Padding="12,5"
                    FontWeight="Bold"
                    Background="#FF2196F3"
                    Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,6,0" Text="&#xE735;" />
                    <TextBlock Text="Use as Root" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="Gray">
                <Run Text="Select a row then click " />
                <Run Text="Use as Root" FontWeight="Bold" />
                <Run Text=" to populate the main window." />
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
