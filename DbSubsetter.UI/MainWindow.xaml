<Window x:Class="DbSubsetter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DbSubsetter.UI"
        Title="DbSubsetter" Height="750" Width="800"
        MinHeight="600" MinWidth="650"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection Panel -->
        <GroupBox Grid.Row="0" Header="Connection" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Profile, Server, Database -->
                <Label Grid.Row="0" Grid.Column="0" Content="Profile:" />
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name" />
                    <Button Grid.Column="1" Content="Save" Command="{Binding SaveProfileCommand}" Padding="8,4" />
                    <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteProfileCommand}" Padding="8,4" />
                </Grid>

                <Label Grid.Row="1" Grid.Column="0" Content="Server:" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="2" Content="Database:" Margin="12,4,0,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="1" Grid.Column="4" Content="Test Connection"
                        Command="{Binding TestConnectionCommand}" Padding="8,4" />

                <!-- Row 2: Auth -->
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Integrated Security"
                          IsChecked="{Binding IntegratedSecurity}" />

                <Label Grid.Row="2" Grid.Column="2" Content="User:" Margin="12,4,0,0"
                       IsEnabled="{Binding SqlAuthEnabled}" />
                <Grid Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding SqlAuthEnabled}" />
                    <Label Grid.Column="1" Content="Pass:" IsEnabled="{Binding SqlAuthEnabled}" />
                    <PasswordBox Grid.Column="2" x:Name="PasswordBox"
                                 IsEnabled="{Binding SqlAuthEnabled}"
                                 PasswordChanged="PasswordBox_PasswordChanged" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Configuration Panel -->
        <GroupBox Grid.Row="1" Header="Configuration" Padding="8" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Root Table:" />
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" IsEditable="True"
                              ItemsSource="{Binding Tables}"
                              SelectedItem="{Binding SelectedTable}"
                              IsEnabled="{Binding ConnectionOk}" />
                    <Button Grid.Column="1" Content="Refresh"
                            Command="{Binding RefreshTablesCommand}" Padding="8,4" />
                </Grid>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Label Content="PK Column:" />
                    <Label Content="{Binding PrimaryKeyColumn}" FontWeight="Bold" />
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="0" Content="PK Value:" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RootPkValue, UpdateSourceTrigger=PropertyChanged}" />
                <Label Grid.Row="1" Grid.Column="2" Content="Max Rows:" />
                <TextBox Grid.Row="1" Grid.Column="3" Width="80"
                         Text="{Binding MaxRowsPerTable, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2" Grid.Column="0" Content="Output File:" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding OutputFile, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="2" Grid.Column="3" Content="Browse..."
                        Command="{Binding BrowseOutputCommand}" Padding="8,4" />
            </Grid>
        </GroupBox>

        <!-- Table Exclusions Panel -->
        <GroupBox Grid.Row="2" Header="Table Inclusions" Padding="8" Margin="0,4,0,0"
                  IsEnabled="{Binding ConnectionOk}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Select All" Command="{Binding SelectAllTablesCommand}" Padding="8,2" Margin="0,0,4,0" />
                    <Button Content="Deselect All" Command="{Binding DeselectAllTablesCommand}" Padding="8,2" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"
                               Text="Unchecked tables will be skipped entirely." />
                </StackPanel>
                <ListBox ItemsSource="{Binding TableSelections}" Height="150"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="LightGray">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsIncluded}" Content="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- Execution Panel -->
        <GroupBox Grid.Row="3" Header="Execution" Padding="8" Margin="0,4,0,0">
            <DockPanel>
                <!-- Top controls -->
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Run Subset" FontWeight="Bold"
                            Command="{Binding RunSubsetCommand}"
                            Background="#FF4CAF50" Foreground="White" Padding="16,6" />
                    <Button Grid.Column="1" Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsRunning}" Padding="16,6" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0"
                               Text="{Binding ConnectionStatus}" Foreground="Gray" />
                </Grid>

                <!-- Progress bar -->
                <ProgressBar DockPanel.Dock="Top" Height="20" Margin="0,8,0,4"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />

                <!-- Log view -->
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="LightGray" />
            </DockPanel>
        </GroupBox>

        <!-- Status bar -->
        <StatusBar Grid.Row="4" Margin="0,4,0,0">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Elapsed: " />
                    <Run Text="{Binding ElapsedTime, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="INSERTs: " />
                    <Run Text="{Binding TotalInserts, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Current: " />
                    <Run Text="{Binding CurrentTable, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
