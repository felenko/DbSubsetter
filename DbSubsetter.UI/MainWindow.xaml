<Window x:Class="DbSubsetter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DbSubsetter.UI"
        Title="DbSubsetter" Height="820" Width="800"
        MinHeight="650" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/DbSubsetter.UI;component/Icons/AppIcon.png">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection Panel -->
        <GroupBox Grid.Row="0" Header="Connection" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Provider, Profile, Save, Delete -->
                <Label Grid.Row="0" Grid.Column="0" Content="Provider:" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                          ItemsSource="{Binding ProviderList}"
                          SelectedItem="{Binding Provider}"
                          ToolTip="SQL Server or SQLite database" />
                <Label Grid.Row="0" Grid.Column="2" Content="Profile:" Margin="12,0,0,0" />
                <Grid Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name" />
                    <Button Grid.Column="1" Command="{Binding SaveProfileCommand}" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74E;" />
                            <TextBlock Text="Save" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding DeleteProfileCommand}" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" />
                            <TextBlock Text="Delete" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 1: Server / Database file + Test -->
                <Label Grid.Row="1" Grid.Column="0" Content="{Binding ServerLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="SQL Server: server name. SQLite: path to .db file" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseDatabaseFileCommand}"
                        Padding="8,4" Margin="4,0,0,0"
                        Visibility="{Binding IsSQLite, Converter={StaticResource BoolToVis}}" />
                <Label Grid.Row="1" Grid.Column="2" Content="Database:" Margin="12,4,0,0"
                       Visibility="{Binding ShowServerDatabase, Converter={StaticResource BoolToVis}}" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowServerDatabase, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Row="1" Grid.Column="4" Command="{Binding TestConnectionCommand}" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xEC25;" />
                        <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Row 2: Auth (SQL Server: IntSec + User/Pass; MySQL/Postgres: User/Pass only) -->
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Integrated Security"
                          IsChecked="{Binding IntegratedSecurity}"
                          Visibility="{Binding ShowIntegratedSecurity, Converter={StaticResource BoolToVis}}" />

                <Label Grid.Row="2" Grid.Column="2" Content="User:" Margin="12,4,0,0"
                       IsEnabled="{Binding UserPasswordEnabled}"
                       Visibility="{Binding ShowServerDatabase, Converter={StaticResource BoolToVis}}" />
                <Grid Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                      Visibility="{Binding ShowServerDatabase, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding UserPasswordEnabled}" />
                    <Label Grid.Column="1" Content="Pass:" IsEnabled="{Binding UserPasswordEnabled}" />
                    <PasswordBox Grid.Column="2" x:Name="PasswordBox"
                                 IsEnabled="{Binding UserPasswordEnabled}"
                                 PasswordChanged="PasswordBox_PasswordChanged" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Configuration Panel -->
        <GroupBox Grid.Row="1" Header="Configuration" Padding="8" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Root Table:" />
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" IsEditable="True"
                              ItemsSource="{Binding Tables}"
                              SelectedItem="{Binding SelectedTable}"
                              IsEnabled="{Binding ConnectionOk}" />
                    <Button Grid.Column="1" Command="{Binding RefreshTablesCommand}" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding OpenBrowserCommand}"
                            IsEnabled="{Binding ConnectionOk}"
                            Padding="8,4" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8F0;" />
                            <TextBlock Text="Browse DB..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Label Content="PK Column:" />
                    <Label Content="{Binding PrimaryKeyColumn}" FontWeight="Bold" />
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="0" Content="PK Value:" />
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RootPkValue, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type a PK value, or load rows below and select one" />
                    <Button Grid.Column="1" Command="{Binding LoadRootCandidatesCommand}" Padding="8,4" Margin="8,0,0,0"
                            ToolTip="Load sample rows from the root table to pick the root entry">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8FD;" />
                            <TextBlock Text="Load rows..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Label Grid.Row="2" Grid.Column="0" Content="Pick row:" VerticalAlignment="Top" Margin="0,4,0,0" />
                <ListBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0"
                         ItemsSource="{Binding RootRowCandidates}"
                         SelectedItem="{Binding SelectedRootRow}"
                         DisplayMemberPath="Display"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="LightGray"
                         ToolTip="Load rows first, then select one to set PK Value above" />

                <Label Grid.Row="3" Grid.Column="0" Content="Max Rows:" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                         Text="{Binding MaxRowsPerTable, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                            Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Output:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Content="Export to File" IsChecked="{Binding IsFileMode}"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                    <RadioButton Content="Copy to Database" IsChecked="{Binding IsDbMode}"
                                 VerticalAlignment="Center" />
                </StackPanel>

                <!-- Row 4: Output File — visible in file mode only -->
                <Label Grid.Row="4" Grid.Column="0" Content="Output File:"
                       Visibility="{Binding FilePanelVisibility}" />
                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                      Visibility="{Binding FilePanelVisibility}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputFile, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..." Margin="4,0,0,0"
                            Command="{Binding BrowseOutputCommand}" Padding="8,4" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Destination Panel — visible in DB mode only -->
        <GroupBox Grid.Row="2" Header="Destination" Padding="8" Margin="0,4,0,0"
                  Visibility="{Binding DbPanelVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Server, Database, Test Connection -->
                <Label Grid.Row="0" Grid.Column="0" Content="Server:" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DestServer, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="0" Grid.Column="2" Content="Database:" Margin="12,4,0,0" />
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding DestDatabase, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="0" Grid.Column="4" Command="{Binding TestDestConnectionCommand}" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xEC25;" />
                        <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Row 1: Auth + Status -->
                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Integrated Security"
                          IsChecked="{Binding DestIntegratedSecurity}" />

                <Label Grid.Row="1" Grid.Column="2" Content="User:" Margin="12,4,0,0"
                       IsEnabled="{Binding DestSqlAuthEnabled}" />
                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DestUsername, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DestSqlAuthEnabled}" />
                    <Label Grid.Column="1" Content="Pass:" IsEnabled="{Binding DestSqlAuthEnabled}" />
                    <PasswordBox Grid.Column="2" x:Name="DestPasswordBox"
                                 IsEnabled="{Binding DestSqlAuthEnabled}"
                                 PasswordChanged="DestPasswordBox_PasswordChanged" />
                    <Label Grid.Column="3" Content="{Binding DestConnectionStatus}" Foreground="Gray" Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Table Exclusions Panel -->
        <GroupBox Grid.Row="3" Header="Table Inclusions" Padding="8" Margin="0,4,0,0"
                  IsEnabled="{Binding ConnectionOk}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Command="{Binding SelectAllTablesCommand}" Padding="8,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE73E;" />
                            <TextBlock Text="Select All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeselectAllTablesCommand}" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE711;" />
                            <TextBlock Text="Deselect All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"
                               Text="Unchecked tables will be skipped entirely." />
                </StackPanel>
                <ListBox ItemsSource="{Binding TableSelections}" Height="150"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="LightGray">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsIncluded}" Content="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- Execution Panel -->
        <GroupBox Grid.Row="4" Header="Execution" Padding="8" Margin="0,4,0,0">
            <DockPanel>
                <!-- Top controls -->
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" FontWeight="Bold"
                            Command="{Binding RunSubsetCommand}"
                            Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="&#xE768;" />
                            <TextBlock Text="Run Subset" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsRunning}" Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE711;" />
                            <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0"
                               Text="{Binding ConnectionStatus}" Foreground="Gray" />
                </Grid>

                <!-- Progress bar -->
                <ProgressBar DockPanel.Dock="Top" Height="20" Margin="0,8,0,4"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />

                <!-- Log view -->
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         BorderThickness="1" BorderBrush="LightGray" />
            </DockPanel>
        </GroupBox>

        <!-- Status bar -->
        <StatusBar Grid.Row="5" Margin="0,4,0,0">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Elapsed: " />
                    <Run Text="{Binding ElapsedTime, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Rows: " />
                    <Run Text="{Binding TotalInserts, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Current: " />
                    <Run Text="{Binding CurrentTable, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
